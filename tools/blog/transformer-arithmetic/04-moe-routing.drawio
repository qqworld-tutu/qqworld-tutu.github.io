or=#253747;fillColor=#f2f3f5;strokeColor=#b6c1c9;dashed=0;fillColor=none;strokeColor=none;"><mxGeometry x="20" y="14" width="760" height="32" as="geometry" /></mxCell><mxCell id="subtitle" value="示例 E = 4、k = 2；采用 Mixtral 式概率归一化" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#253747;fillColor=#f2f3f5;strokeColor=#b6c1c9;dashed=0;fillColor=none;strokeColor=none;"><mxGeometry x="20" y="52" width="760" height="28" as="geometry" /></mxCell><mxCell id="x" value="输入 x&lt;br&gt;[1, d]" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#253747;fillColor=#e3eff4;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="30" y="108" width="150" height="65" as="geometry" /></mxCell><mxCell id="router" value="Router：x W&lt;sub&gt;r&lt;/sub&gt;&lt;br&gt;W&lt;sub&gt;r&lt;/sub&gt; [d, E]" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#253747;fillColor=#eee8f5;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="225" y="108" width="225" height="65" as="geometry" /></mxCell><mxCell id="prob" value="softmax → 专家概率&lt;br&gt;[0.10, 0.50, 0.30, 0.10]" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#253747;fillColor=#eee8f5;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="500" y="108" width="265" height="65" as="geometry" /></mxCell><mxCell id="topk" value="Top-k：取概率最大的 2 项" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#253747;fillColor=#f2f3f5;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="500" y="220" width="265" height="54" as="geometry" /></mxCell><mxCell id="ids" value="选中编号：(2, 3)&lt;br&gt;整数，取值 1 到 4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#253747;fillColor=#e3eff4;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="225" y="315" width="225" height="60" as="geometry" /></mxCell><mxCell id="values" value="选中概率&lt;br&gt;(0.50, 0.30)" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#253747;fillColor=#eee8f5;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="500" y="315" width="265" height="60" as="geometry" /></mxCell><mxCell id="weights" value="选中概率重新归一化&lt;br&gt;α₂ = 0.625，α₃ = 0.375" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#253747;fillColor=#eee8f5;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="500" y="440" width="265" height="70" as="geometry" /></mxCell><mxCell id="dispatch" value="Dispatch：按编号 (2, 3)&lt;br&gt;把同一个 x 送给专家 2、3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#253747;fillColor=#e3eff4;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="30" y="440" width="290" height="70" as="geometry" /></mxCell><mxCell id="exp0" value="专家 1：SwiGLU&lt;br&gt;本 token 不调用" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#253747;fillColor=#f2f3f5;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="30" y="580" width="165" height="65" as="geometry" /></mxCell><mxCell id="exp1" value="专家 2：SwiGLU&lt;br&gt;计算 f2(x)" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#253747;fillColor=#f9e7d8;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="220" y="580" width="165" height="65" as="geometry" /></mxCell><mxCell id="exp2" value="专家 3：SwiGLU&lt;br&gt;计算 f3(x)" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#253747;fillColor=#f9e7d8;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="410" y="580" width="165" height="65" as="geometry" /></mxCell><mxCell id="exp3" value="专家 4：SwiGLU&lt;br&gt;本 token 不调用" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#253747;fillColor=#f2f3f5;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="600" y="580" width="165" height="65" as="geometry" /></mxCell><mxCell id="gather" value="Gather：按权重相加&lt;br&gt;y = 0.625 f₂(x) + 0.375 f₃(x)" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#253747;fillColor=#e4f0ea;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="210" y="715" width="380" height="74" as="geometry" /></mxCell><mxCell id="note" value="编号决定送给谁；权重决定各专家输出占多少。未选中专家不参与本次计算。" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#253747;fillColor=#f2f3f5;strokeColor=#b6c1c9;dashed=0;fillColor=none;strokeColor=none;"><mxGeometry x="40" y="834" width="720" height="35" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
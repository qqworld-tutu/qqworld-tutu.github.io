y="799" as="sourcePoint" /><mxPoint x="495" y="857" as="targetPoint" /></mxGeometry></mxCell><mxCell id="title" value="KV Cache：每层各存一份 K 和 V" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=24;fontColor=#253747;fillColor=#f2f3f5;strokeColor=#b6c1c9;dashed=0;fillColor=none;strokeColor=none;"><mxGeometry x="20" y="14" width="760" height="32" as="geometry" /></mxCell><mxCell id="subtitle" value="先处理 prompt；之后每次只计算当前 token" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#253747;fillColor=#f2f3f5;strokeColor=#b6c1c9;dashed=0;fillColor=none;strokeColor=none;"><mxGeometry x="20" y="52" width="760" height="28" as="geometry" /></mxCell><mxCell id="prefill" value="Prefill：逐层处理 prompt；每层并行计算 S 个位置的 Q/K/V&lt;br&gt;缓存各层的 K、V；末位置 logits 给出第一个生成 token" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#253747;fillColor=#e3eff4;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="35" y="110" width="730" height="72" as="geometry" /></mxCell><mxCell id="step" value="下面放大某一层的一步 decode：缓存长度从 T − 1 变成 T" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#253747;fillColor=#f2f3f5;strokeColor=#b6c1c9;dashed=0;fillColor=none;strokeColor=none;"><mxGeometry x="30" y="205" width="740" height="35" as="geometry" /></mxCell><mxCell id="x" value="当前 token 的归一化输入" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#253747;fillColor=#e3eff4;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="260" y="270" width="280" height="50" as="geometry" /></mxCell><mxCell id="q" value="Q 投影 + RoPE&lt;br&gt;当前 q [B, h, 1, d&lt;sub&gt;h&lt;/sub&gt;]" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#253747;fillColor=#e3eff4;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="35" y="365" width="210" height="64" as="geometry" /></mxCell><mxCell id="k" value="K 投影 + RoPE&lt;br&gt;新 k [B, n&lt;sub&gt;kv&lt;/sub&gt;, 1, d&lt;sub&gt;h&lt;/sub&gt;]" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#253747;fillColor=#f9e7d8;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="295" y="365" width="210" height="64" as="geometry" /></mxCell><mxCell id="v" value="V 投影&lt;br&gt;新 v [B, n&lt;sub&gt;kv&lt;/sub&gt;, 1, d&lt;sub&gt;h&lt;/sub&gt;]" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#253747;fillColor=#f9e7d8;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="555" y="365" width="210" height="64" as="geometry" /></mxCell><mxCell id="kc" value="追加到旧 K 后&lt;br&gt;K [B, n&lt;sub&gt;kv&lt;/sub&gt;, T, d&lt;sub&gt;h&lt;/sub&gt;]&lt;br&gt;旧 T − 1 + 新 1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#253747;fillColor=#f9e7d8;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="295" y="482" width="210" height="82" as="geometry" /></mxCell><mxCell id="vc" value="追加到旧 V 后&lt;br&gt;V [B, n&lt;sub&gt;kv&lt;/sub&gt;, T, d&lt;sub&gt;h&lt;/sub&gt;]&lt;br&gt;旧 T − 1 + 新 1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#253747;fillColor=#f9e7d8;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="555" y="482" width="210" height="82" as="geometry" /></mxCell><mxCell id="scores" value="q Kᵀ / √d&lt;sub&gt;h&lt;/sub&gt; → softmax&lt;br&gt;每个 Query 头得到 [1, T] 的概率" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#253747;fillColor=#eee8f5;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="35" y="620" width="470" height="60" as="geometry" /></mxCell><mxCell id="av" value="概率 × V → 各头输出 → 拼接 → W&lt;sub&gt;O&lt;/sub&gt;&lt;br&gt;本层 Attention 输出 [B, 1, d]" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#253747;fillColor=#e4f0ea;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="230" y="739" width="535" height="60" as="geometry" /></mxCell><mxCell id="end" value="继续：残差、FFN、后续层 → 最终 Norm 与输出头&lt;br&gt;得到下一个 token 的 logits；每层缓存都保留到下一步" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#253747;fillColor=#f2f3f5;strokeColor=#b6c1c9;dashed=0;"><mxGeometry x="135" y="857" width="630" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>